diff --git a/include/rex/system/ios_guest_backing.h b/include/rex/system/ios_guest_backing.h
new file mode 100644
index 0000000..47b4623
--- /dev/null
+++ b/include/rex/system/ios_guest_backing.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <mach/mach.h>
+#include <mach/vm_map.h>
+
+namespace rex::memory::ios {
+
+// A named Mach memory object provides shared backing without a filesystem name.
+class GuestBacking {
+ public:
+  GuestBacking() = default;
+  GuestBacking(const GuestBacking&) = delete;
+  GuestBacking& operator=(const GuestBacking&) = delete;
+
+  ~GuestBacking() {
+    if (entry_ != MACH_PORT_NULL) {
+      mach_port_deallocate(mach_task_self(), entry_);
+    }
+  }
+
+  kern_return_t Create(memory_object_size_t size) {
+    return mach_make_memory_entry_64(mach_task_self(), &size, 0,
+                                    MAP_MEM_NAMED_CREATE | VM_PROT_READ | VM_PROT_WRITE,
+                                    &entry_, MACH_PORT_NULL);
+  }
+
+  // The caller owns the entire reserved range containing this view.
+  kern_return_t MapReserved(void* destination, vm_size_t size,
+                           memory_object_offset_t offset) const {
+    auto address = reinterpret_cast<vm_address_t>(destination);
+    constexpr vm_prot_t access = VM_PROT_READ | VM_PROT_WRITE;
+    static_assert(sizeof(vm_offset_t) >= sizeof(memory_object_offset_t));
+    return vm_map(mach_task_self(), &address, size, 0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE,
+                  entry_, static_cast<vm_offset_t>(offset), false, access, access,
+                  VM_INHERIT_NONE);
+  }
+
+ private:
+  mach_port_t entry_ = MACH_PORT_NULL;
+};
+
+}  // namespace rex::memory::ios
